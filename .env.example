# Copy this file to .env and fill in only the values you need.
# Never put a real token or password in this example file.

# Optional. Required only for pyannote speaker diarization after accepting
# the model terms on Hugging Face.
HF_TOKEN=

# Local Ollama model settings
RAG_LLM_BACKEND=local
RAG_LLM_MODEL=qwen3:0.6b
RAG_LLM_NUM_CTX=4096
RAG_LLM_TEMPERATURE=0.2
RAG_OLLAMA_HOST=http://localhost:11434
RAG_OLLAMA_TIMEOUT_SECONDS=600
RAG_CLASSIFY_THINK=false

# Local application settings
RAG_PORT=8000

# Optional audio transcription tuning. Leave hotwords blank unless you need
# domain-specific vocabulary; long lists can slow transcription or bias it.
RAG_ASR_HOTWORDS=
RAG_ASR_BATCH_SIZE=8
RAG_ASR_CHUNK_LENGTH=30

# Keep the reranker loaded between turns by default.
RAG_RELEASE_RERANKER=false
